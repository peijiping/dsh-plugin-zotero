{
  "name": "dsh-plugin-zotero",
  "version": "0.1.3",
  "description": "Connect your local Zotero library to DSH. Once installed, the model can view, search and read your Zotero papers, notes and PDF full text, while you can browse the same library in a read-only sidebar and send a citation, an excerpt or a whole collection into the conversation with one click.",
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "dsh-plugin",
    "zotero",
    "cordis",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peijiping/dsh-plugin-zotero.git"
  },
  "homepage": "https://github.com/peijiping/dsh-plugin-zotero#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "prepack": "pnpm build && pnpm build:client"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.19.2",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  }
}